# Environment files
.env
.env.*
!.env.example
!.env.*.example
**/.env

# Dependencies & Build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
frontend/dist/
frontend/.vite/
target/
**/target/
build/
**/build/
*.class

# IDE and OS files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.log
logs/

# Cryptographic keys and private PEM certs
*.pem
*.key
infrastructure/keys/*.pem
!infrastructure/keys/.gitkeep
**/certs/*private*.pem
backend/auth-service/src/main/resources/certs/
!**/src/test/resources/certs/*.pem

# Docs test reports (ensure reports are not ignored except temporary files)
!docs/test-reports/**/html/
