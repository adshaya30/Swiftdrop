# PostgreSQL database name, user, and local-only password used by Compose.
POSTGRES_DB=swiftdrop
POSTGRES_USER=replace_with_local_database_user
POSTGRES_PASSWORD=replace_with_a_local_password

# RabbitMQ application user and local-only password used by Compose.
RABBITMQ_USER=replace_with_local_rabbitmq_user
RABBITMQ_PASSWORD=replace_with_a_local_password
