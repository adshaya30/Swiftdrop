# ============================================================
# SwiftDrop Local Development Environment Variables
# ============================================================
# Copy this file to .env and run scripts/init-env.sh (or .ps1)
# to generate random secrets. Never commit the resulting .env.
#
# Key generation: run scripts/generate-keys.sh (or .ps1)
# DEP-013: JWT keys are mounted read-only at /run/keys/ in containers.
# ============================================================

# ── PostgreSQL (superuser, used only by init-databases.sh) ───────────────────
# NFR-SEC-021: superuser password used only by the init script.
POSTGRES_USER=swiftdrop_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=postgres

# ── Per-service DB passwords (SRS 9.2 / DEP-008) ─────────────────────────────
# Each service gets its own least-privilege user and database.
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
PARCEL_DB_PASSWORD=CHANGE_ME_PARCEL_DB_PASSWORD
PRICING_DB_PASSWORD=CHANGE_ME_PRICING_DB_PASSWORD
DELIVERY_DB_PASSWORD=CHANGE_ME_DELIVERY_DB_PASSWORD
TRACKING_DB_PASSWORD=CHANGE_ME_TRACKING_DB_PASSWORD
NOTIFICATION_DB_PASSWORD=CHANGE_ME_NOTIFICATION_DB_PASSWORD

# ── RabbitMQ (SRS 9.2) ───────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=swiftdrop_user
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_DEFAULT_PASS

# ── JWT Key Files (SRS 9.2 / DEP-013) ───────────────────────────────────────
# Generate with: scripts/generate-keys.sh (or .ps1)
# Mounted read-only at /run/keys/ in Docker; private key ONLY into auth-service.
JWT_PRIVATE_KEY_PATH=/run/keys/swiftdrop_private.pem
JWT_PUBLIC_KEY_PATH=/run/keys/swiftdrop_public.pem

# ── JWT Token TTLs (auth-service, SRS 9.2) ───────────────────────────────────
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
REFRESH_ABSOLUTE_TTL_DAYS=30
REFRESH_GRACE_SECONDS=10

# ── Public Base URL (SRS 9.2 / FR-PAR-007) ───────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8080

# ── Google OAuth (auth-service, SRS 9.2) ─────────────────────────────────────
# Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${PUBLIC_BASE_URL}/api/v1/auth/google/callback

# ── Shared Security (SRS 9.2) ────────────────────────────────────────────────
# INTERNAL_API_KEY: at least 32 chars; used by X-Internal-Key header.
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY
# Set to true when serving behind HTTPS (production only)
HSTS_ENABLED=false
COOKIE_SECURE=false
# Rate limiting (disable during local dev if needed)
RATE_LIMIT_ENABLED=true

# ── Bootstrap Admin (auth-service, FR-AUTH-015) ───────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@swiftdrop.lk
BOOTSTRAP_ADMIN_NAME=System Admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_ADMIN_PASSWORD

# ── Demo Seed (DEP-016 optional) ─────────────────────────────────────────────
DEMO_SEED_ENABLED=false
DEMO_USER_PASSWORD=CHANGE_ME_DEMO_USER_PASSWORD

# ── Service Internal URLs (SRS 9.2 / 3.1) ────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8081
PARCEL_SERVICE_URL=http://parcel-service:8082
PRICING_SERVICE_URL=http://pricing-service:8083
DELIVERY_SERVICE_URL=http://delivery-service:8084
TRACKING_SERVICE_URL=http://tracking-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086
FRONTEND_URL=http://frontend:8080
AI_ASSISTANT_URL=http://ai-assistant:8000
MOCK_MERCHANT_URL=http://mock-merchant:9000

# ── Pricing Service (SRS 9.2 / BR-10) ────────────────────────────────────────
# MAX_PARCEL_WEIGHT_KG lives ONLY in pricing-service (master prompt rule 14).
MAX_PARCEL_WEIGHT_KG=30

# ── Delivery Service (SRS 9.2) ───────────────────────────────────────────────
MAX_UPLOAD_MB=10
MAX_STORED_PHOTO_MB=5

# ── Notification / Webhooks (SRS 9.2 / FR-WHK-007) ──────────────────────────
# WEBHOOK_SECRET_ENCRYPTION_KEY: Base64 of 32 random bytes.
WEBHOOK_SECRET_ENCRYPTION_KEY=CHANGE_ME_WEBHOOK_SECRET_ENCRYPTION_KEY
# Allow private/local targets in demo mode so mock-merchant works.
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_DELAYS=PT1M,PT5M,PT30M,PT2H,PT6H

# ── SMTP / Mail (notification-service, SRS 9.2) ──────────────────────────────
# In development Mailpit handles SMTP at mailpit:1025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@swiftdrop.example
SMS_PROVIDER=mock

# ── Outbox Polling (publishers: auth, parcel, pricing, delivery) ──────────────
OUTBOX_POLL_INTERVAL_MS=1000

# ── Logging / Observability (SRS 9.2) ────────────────────────────────────────
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=dev
SWAGGER_ENABLED=true

# ── Gateway (SRS 9.2) ────────────────────────────────────────────────────────
MANAGEMENT_SERVER_PORT=8090

# ── Frontend (SRS 9.2 / DEP-002) ─────────────────────────────────────────────
# Empty in the container build (uses relative paths); set for npm run dev.
VITE_API_BASE_URL=http://localhost:8080

# ── AI Assistant (bonus scope, SRS 11, out of scope unless task says otherwise)
ANTHROPIC_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=claude-haiku-5-5
AI_MAX_TOOL_ITERATIONS=5
AI_MAX_OUTPUT_TOKENS=600
AI_HISTORY_LIMIT=10

# ─────────────────────────────────────────────────────────────────────────────
# Service ↔ Variable mapping (which service reads which variable)
# ─────────────────────────────────────────────────────────────────────────────
# Service              | Key variables
# ---------------------|--------------------------------------------------------
# All Java services    | SPRING_PROFILES_ACTIVE, LOG_LEVEL, INTERNAL_API_KEY, SWAGGER_ENABLED
# All except gateway   | DB_URL, DB_USER, DB_PASSWORD (mapped per-service in compose.yaml)
#                      | JWT_PUBLIC_KEY_PATH
#                      | RABBITMQ_HOST, RABBITMQ_PORT, RABBITMQ_USER, RABBITMQ_PASSWORD
# auth-service         | JWT_PRIVATE_KEY_PATH, JWT_ACCESS_TTL_MINUTES, REFRESH_TTL_DAYS,
#                      | REFRESH_ABSOLUTE_TTL_DAYS, REFRESH_GRACE_SECONDS, COOKIE_SECURE,
#                      | PUBLIC_BASE_URL, DELIVERY_SERVICE_URL, GOOGLE_CLIENT_ID,
#                      | GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI, BOOTSTRAP_ADMIN_EMAIL,
#                      | BOOTSTRAP_ADMIN_NAME, BOOTSTRAP_ADMIN_PASSWORD, DEMO_SEED_ENABLED,
#                      | DEMO_USER_PASSWORD
# parcel-service       | PRICING_SERVICE_URL, AUTH_SERVICE_URL, PUBLIC_BASE_URL
# pricing-service      | MAX_PARCEL_WEIGHT_KG
# delivery-service     | PARCEL_SERVICE_URL, MAX_UPLOAD_MB, MAX_STORED_PHOTO_MB
# notification-service | AUTH_SERVICE_URL, PARCEL_SERVICE_URL, PUBLIC_BASE_URL,
#                      | SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM,
#                      | SMS_PROVIDER, WEBHOOK_SECRET_ENCRYPTION_KEY,
#                      | WEBHOOK_ALLOW_PRIVATE_TARGETS, WEBHOOK_ALLOW_HTTP,
#                      | WEBHOOK_TIMEOUT_SECONDS, WEBHOOK_MAX_ATTEMPTS, WEBHOOK_RETRY_DELAYS
# api-gateway          | AUTH_SERVICE_URL, PARCEL_SERVICE_URL, PRICING_SERVICE_URL,
#                      | DELIVERY_SERVICE_URL, TRACKING_SERVICE_URL, NOTIFICATION_SERVICE_URL,
#                      | FRONTEND_URL, AI_ASSISTANT_URL, PUBLIC_BASE_URL, RATE_LIMIT_ENABLED,
#                      | HSTS_ENABLED, MANAGEMENT_SERVER_PORT
# ai-assistant         | ANTHROPIC_API_KEY, LLM_PROVIDER, LLM_MODEL, TRACKING_SERVICE_URL,
#                      | PRICING_SERVICE_URL, PARCEL_SERVICE_URL, PUBLIC_BASE_URL,
#                      | AI_MAX_TOOL_ITERATIONS, AI_MAX_OUTPUT_TOKENS, AI_HISTORY_LIMIT, LOG_LEVEL
# frontend (build)     | VITE_API_BASE_URL
# postgres             | POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, AUTH_DB_PASSWORD,
#                      | PARCEL_DB_PASSWORD, PRICING_DB_PASSWORD, DELIVERY_DB_PASSWORD,
#                      | TRACKING_DB_PASSWORD, NOTIFICATION_DB_PASSWORD
# rabbitmq             | RABBITMQ_DEFAULT_USER, RABBITMQ_DEFAULT_PASS
